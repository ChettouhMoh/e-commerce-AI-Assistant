APP_ENV=local
HTTP_ADDR=:8080

# LLM Configuration
# Option 1: Groq (recommended for weak hardware - free tier available)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-20b

# Option 2: Ollama (local, no API costs)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2:3b

# Embedding Configuration
# Option 1: Hugging Face (free tier available)
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Option 2: Ollama (local)
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# WhatsApp Configuration (optional for development)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v18.0
WHATSAPP_WEBHOOK_SIGNATURE_REQUIRED=false

# Tool and Retrieval Configuration
MAX_TOOL_CALLS=5
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
REQUEST_TIMEOUT=30
LLM_TIMEOUT=60
